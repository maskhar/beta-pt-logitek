---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ValueSection from '../components/sections/ValueSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import ChecklistSection from '../components/sections/ChecklistSection.astro';
import BusinessSections from '../components/sections/BusinessSections.astro';
import WhySection from '../components/sections/WhySection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import ClosingSections from '../components/sections/ClosingSections.astro';
---
<BaseLayout title="PT Logitek | Foreign Investor Support in Indonesia" description="Your local partner in Indonesia for investment exploration, company setup, partnerships, documents and family relocation. Based in Malang, East Java.">
