  <Header />
  <main id="main-content"><HeroSection /><ValueSection /><AboutSection /><ServicesSection /><ChecklistSection /><BusinessSections /><WhySection /><ProcessSection /><ClosingSections /></main>
  <Footer />
</BaseLayout>
