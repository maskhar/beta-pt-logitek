---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import InnerPageHero from '../components/ui/InnerPageHero.astro';
import { documentChecklist, processSteps } from '../data/content';
---
<BaseLayout title="Investor Checklist | PT Logitek" description="A starting checklist for investors preparing documents, company plans and a move to Indonesia. Requirements are confirmed by consultation.">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header />
  <main id="main-content">
    <div id="top"><InnerPageHero eyebrow="PT Logitek / Investor guide" title="Prepare well. Move with clarity." description="Start with the documents and decisions that shape your Indonesia plan. Exact requirements depend on your purpose, company structure and applicant profile." /></div>

    <section class="checklist-section inner-section" id="guide" aria-labelledby="checklist-title"><div class="wrapper checklist-grid inner-grid"><div class="checklist-copy inner-intro"><p class="eyebrow">Document preparation</p><h2 id="checklist-title">A practical<br /><em>starting point.</em></h2><p>Use this list to organize an initial conversation. It is not a definitive visa or licensing requirement list.</p><div class="guide-callout inner-notice"><span class="guide-callout-icon" aria-hidden="true">i</span><p>Supporting documents may vary by <strong>visa purpose, company structure and applicant profile.</strong> Final handling depends on document readiness and case needs.</p></div><div class="inner-links"><Button href="#contact" variant="text">Consultation details</Button></div></div><div class="checklist-card inner-card"><div class="checklist-card-head"><div><span>PT LOGITEK / INVESTOR GUIDE</span><h3>Document checklist</h3></div><span class="checklist-count">01—12</span></div><ul>{documentChecklist.map((item, index) => <li><span class="check-circle"><Icon name="check" size={16} /></span><span>{item}</span><small>{String(index + 1).padStart(2, '0')}</small></li>)}</ul><div class="checklist-card-foot">STARTING POINT <span>Requirements confirmed by consultation</span></div></div></div></section>

    <section class="investment-section inner-section" id="investment" aria-labelledby="investment-title"><div class="wrapper investment-grid inner-grid"><div class="investment-copy inner-intro"><p class="eyebrow eyebrow-gold">Investment &amp; establishment</p><h2 id="investment-title">Know your goals<br /><em>before you commit.</em></h2><p>We build an investment profile around your budget, preferred industry, experience, target location, objectives and partnership preferences before exploring opportunities.</p><div class="inner-links"><Button href="#contact" variant="gold">Consultation details</Button></div></div><div class="investment-list"><div class="investment-list-heading"><span>AREAS TO DISCUSS</span><span>01 / 04</span></div>{['Intended business activity & sector', 'PT PMA company establishment', 'Potential locations & partners', 'Professional review & due diligence'].map((item, index) => <div class="investment-item"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item}</h3><Icon name="check" size={20} /></div>)}<p>Legal, financial, tax, operational and commercial due diligence should be conducted with qualified professionals before investing.</p></div></div></section>

    <section class="process-section inner-section" id="services" aria-labelledby="process-title"><div class="wrapper"><div class="section-intro inner-intro"><div><p class="eyebrow">How we coordinate</p><h2 id="process-title">From first question<br />to <em>what's next.</em></h2></div><p>Every plan differs. These steps show how we organize conversations, preparation and on-the-ground coordination.</p></div><ol class="steps">{processSteps.map(([title, body], index) => <li><span class="step-number">{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>

    <section class="contact-section inner-section inner-cta" id="contact" aria-labelledby="contact-title"><div class="wrapper contact-grid inner-grid"><div id="about" class="inner-intro"><p class="eyebrow">PT Logitek / Malang, East Java</p><h2 id="contact-title">Plan your next step<br /><em>with context.</em></h2><p>PT Logitek coordinates immigration, business, investment and relocation support in Indonesia. Consultations are available by appointment.</p><div class="contact-availability"><span class="availability-dot"></span> CONSULTATION BY APPOINTMENT</div></div><div class="contact-card inner-card"><span class="contact-card-label">PT LOGITEK COMMUNICATION SERVICES</span><h3>Our base in Indonesia</h3><address>University Village B-18<br />Desa Tirtomoyo, Kec. Pakis<br />Kab. Malang, Jawa Timur<br />Indonesia</address><div class="contact-status"><strong>Contact channels pending verification</strong><p>Phone, WhatsApp, email and representative details have not been supplied. No booking or message submission is available yet.</p></div></div></div></section>
  </main>
  <Footer />
</BaseLayout>
