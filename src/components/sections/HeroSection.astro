---
import Button from '../ui/Button.astro';
---
<div class="hero"><div class="wrapper hero-grid">
  <div>
    <h1>Indonesia starts here.<span>From Pakistan to Indonesia.</span></h1>
    <p>PT Logitek Communication Services helps Pakistani investors, entrepreneurs and families enter, establish and grow in Indonesia, from visa to company to home.</p>
    <div class="cta"><Button href="#contact">Start your Indonesia journey</Button><Button href="#services" variant="outline">See our services</Button></div>
  </div>
  <div class="route" aria-label="Route between Pakistan and Indonesia">
    <svg viewBox="0 0 560 330" role="img" aria-labelledby="route-title">
      <title id="route-title">An arc from Pakistan to Malang, Indonesia</title>
      <path class="arc" d="M70 70 C 200 -10, 400 20, 480 250" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round" />
      <circle cx="70" cy="70" r="11" fill="var(--green)" /><circle cx="480" cy="250" r="11" fill="var(--red)" />
      <text x="70" y="108" text-anchor="middle">Pakistan</text><text class="sub" x="70" y="126" text-anchor="middle">Investors &amp; families</text>
      <text x="480" y="288" text-anchor="middle">Malang, Indonesia</text><text class="sub" x="480" y="306" text-anchor="middle">Your Indonesia Desk</text>
    </svg>
  </div>
</div></div>
<div class="strip"><div class="wrapper"><span>Immigration</span><span>Business</span><span>Investment</span><span>Relocation</span><span>Partnership</span></div></div>
