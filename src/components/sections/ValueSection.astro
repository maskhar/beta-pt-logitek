---
import Icon from '../ui/Icon.astro';
import { valuePropositions } from '../../data/content';
---
<section class="value-section section-pad" aria-labelledby="value-title"><div class="wrapper"><div class="section-intro"><div><p class="eyebrow">The right support, at every stage</p><h2 id="value-title">Your ambitions deserve<br /><em>a local advantage.</em></h2></div><p>Whether your plans begin with a visit or a long-term commitment, we help connect the pieces.</p></div><div class="value-grid">{valuePropositions.map((item, index) => <article class="value-card"><div class="value-top"><span>0{index + 1}</span><Icon name={item.icon} size={30} /></div><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></section>
