---
import Icon from '../ui/Icon.astro';
import { servicePillars, serviceBreadth } from '../../data/content';
---
<section class="services-section section-pad" id="services" aria-labelledby="services-title"><div class="wrapper"><div class="section-intro"><div><p class="eyebrow">How we help</p><h2 id="services-title">We can handle<br /><em>what comes next.</em></h2></div><div><p>Eight ways to make your Indonesia plans more practical. Select the support you need; we shape the details together.</p><span class="consultation-chip">ALL SERVICES · BY CONSULTATION</span></div></div><div class="services-grid">{servicePillars.map((item, index) => <a class="service-card" href={item.href} aria-label={`Explore ${item.title}`}><div class="service-card-top"><Icon name={item.icon} size={29} /><span>0{index + 1}</span></div><h3>{item.title}</h3><p>{item.body}</p><span class="service-link">Explore support <span aria-hidden="true">↗</span></span></a>)}</div><div class="service-breadth"><div><p class="eyebrow">More ways we can assist</p><h3>Practical help in the details.</h3></div><ul>{serviceBreadth.map((item) => <li>{item}</li>)}</ul></div></div></section>
