---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { documentChecklist } from '../../data/content';
---
<section class="checklist-section section-pad" id="guide" aria-labelledby="guide-title"><div class="wrapper checklist-grid"><div class="checklist-copy"><p class="eyebrow">Investor guide · A starting point</p><h2 id="guide-title">Prepare well.<br /><em>Move with clarity.</em></h2><p>Documents differ by activity and applicant. Start with these common categories, then confirm your specific requirements in a consultation.</p><div class="guide-callout"><span class="guide-callout-icon">i</span><p>Supporting documents may vary by <strong>visa purpose, company structure and applicant profile.</strong> Final handling depends on document readiness and case needs.</p></div><Button href="/investor-checklist" variant="text">Full investor checklist</Button></div><div class="checklist-card"><div class="checklist-card-head"><div><span>PT LOGITEK / INVESTOR GUIDE</span><h3>Document checklist</h3></div><span class="checklist-count">01—12</span></div><ul>{documentChecklist.map((item, index) => <li><span class="check-circle"><Icon name="check" size={16} /></span><span>{item}</span><small>{String(index + 1).padStart(2, '0')}</small></li>)}</ul><div class="checklist-card-foot">STARTING POINT <span>Requirements confirmed by consultation</span></div></div></div></section>
