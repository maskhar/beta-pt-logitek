---
import Button from './Button.astro';
const { eyebrow, title, description, ctaLabel = 'Consultation details', ctaHref = '/contact' } = Astro.props;
---
<section class="inner-hero" aria-labelledby="page-title">
  <div class="wrapper inner-hero-grid">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{eyebrow}</span></nav>
      <p class="eyebrow eyebrow-gold">{eyebrow}</p>
      <h1 id="page-title">{title}</h1>
    </div>
    <div class="inner-hero-copy"><p>{description}</p>{ctaLabel && <Button href={ctaHref} variant="gold">{ctaLabel}</Button>}</div>
  </div>
</section>
